DJANGO_SECRET_KEY=replace-with-a-new-random-secret
EMAIL_ADDRESS=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
GOOGLE_MAPS_API_KEY=

# Local preview. Set production on the deployed server.
DJANGO_ENV=local
DJANGO_DEBUG=False
# Production: your exact hostname, comma-separated if multiple.
# DJANGO_ALLOWED_HOSTS=benjaminoscaraidoo.pythonanywhere.com
# Enable only behind a trusted HTTPS proxy configured by your hosting provider.
DJANGO_TRUST_PROXY=False
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False

# SMS OTP via Twilio: configure a sender number or Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Arrange ready orders automatically after driver assignment / delivery creation.
AUTO_ROUTE_PLANNING=True

# Optional: absolute directory for private delivery photos; keep outside public/static hosting.
# DELIVERY_PROOF_ROOT=/absolute/path/to/private-delivery-photos

# Customer delivery/payment updates. False queues external messages for the worker command.
NOTIFICATION_SEND_IMMEDIATELY=True
# Optional public website base URL for email/SMS order links; no localhost links are sent by default.
PUBLIC_APP_URL=
